# No real secrets in this file. No-AI mode needs no key.
# Optional local Chromium executable (otherwise packaged Chromium is used)
CHROMIUM_EXECUTABLE_PATH=
# Optional OpenAI-compatible adapter; fixed by owner, never entered in browser
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Per-million-token USD rates; owner must verify official pricing first
AI_INPUT_RATE=
AI_OUTPUT_RATE=
# Password mode until verified email login is connected. Keep private.
APP_PASSWORD=

# Paste any public source URL in the private app; no domain registration needed.
# Maximum reservation per AI request; client cannot raise this limit.
AI_MAX_REQUEST_USD=0.25

# Verified owner-email login. Connect Supabase and configure OTP email templates first.
# In email mode the old password never bypasses verified-email authorization.
AUTH_MODE=basic
OWNER_EMAIL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
